# Public (safe for client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER-ONLY. Bypasses all RLS — the single highest-value secret (TRD §9).
# Never import into client components; only via src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Messaging
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
# Sender; defaults to Resend's shared test address until you verify a domain.
RESEND_FROM="Waqt <bookings@resend.dev>"

# Gates /api/jobs/send-reminders; the GitHub Actions workflow sends it as a
# Bearer token (.github/workflows/send-reminders.yml). TRD §9.
CRON_SECRET=
